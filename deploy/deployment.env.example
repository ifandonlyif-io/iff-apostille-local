# Fill these values from a verified local installation; none are certified pins.
# No credentials belong here. Keep this file administrator-owned.
APOSTILLE_GATEWAY_IMAGE=
APOSTILLE_CONFIG_DIR=
APOSTILLE_CONFIG_FILE=config.json
APOSTILLE_TLS_DIR=
APOSTILLE_EVIDENCE_DIR=
APOSTILLE_SIGNING_DIR=
APOSTILLE_BIND_IP=127.0.0.1
APOSTILLE_PORT=8443
APOSTILLE_INGRESS_SUBNET=
APOSTILLE_INFERENCE_SUBNET=
APOSTILLE_GPU_DEVICE=
# AMD only:
APOSTILLE_AMD_RENDER_DEVICE=
APOSTILLE_RENDER_GID=
APOSTILLE_VIDEO_GID=
