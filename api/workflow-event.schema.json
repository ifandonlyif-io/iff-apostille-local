{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apostille:workflow-event:0.1",
  "title": "Workflow metadata assertion, software preview",
  "description": "All identifiers are opaque. Numeric counters are canonical decimal strings. Signed assertions do not prove actual execution, content truth or current authorization. Optional artifact binding requires explicit local file selection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evidence_scope",
    "project_id",
    "job_id",
    "agent_id",
    "event_id",
    "configuration_id",
    "model_id",
    "sequence",
    "round",
    "event_type",
    "framework",
    "framework_version",
    "artifact_sha256",
    "artifact_size"
  ],
  "properties": {
    "schema": {
      "const": "urn:apostille:workflow-event:0.1"
    },
    "evidence_scope": {
      "const": "workflow_metadata_only"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "configuration_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "model_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "sequence": {
      "type": "string",
      "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990|9007199254740991)$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "round": {
      "type": "string",
      "anyOf": [
        {
          "const": ""
        },
        {
          "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990|9007199254740991)$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      ]
    },
    "event_type": {
      "enum": [
        "configuration_approved",
        "work_completed",
        "work_failed",
        "work_cancelled",
        "model_released",
        "deployment_accepted"
      ]
    },
    "framework": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]{0,31}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "framework_version": {
      "type": "string",
      "pattern": "^[0-9][A-Za-z0-9.+_-]{0,31}$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "artifact_sha256": {
      "type": "string",
      "pattern": "^(?:|[a-f0-9]{64})$",
      "not": {
        "pattern": "[\\r\\n]"
      }
    },
    "artifact_size": {
      "type": "string",
      "anyOf": [
        {
          "const": ""
        },
        {
          "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
          "not": {
            "pattern": "[\\r\\n]"
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "enum": [
              "work_completed",
              "work_failed",
              "work_cancelled"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "round": {
            "pattern": "^(?:[1-9][0-9]{0,14}|[1-8][0-9]{15}|900[0-6][0-9]{12}|90070[0-9]{11}|90071[0-8][0-9]{10}|900719[0-8][0-9]{9}|9007199[0-1][0-9]{8}|90071992[0-4][0-9]{7}|900719925[0-3][0-9]{6}|9007199254[0-6][0-9]{5}|90071992547[0-3][0-9]{4}|9007199254740[0-8][0-9]{2}|90071992547409[0-8][0-9]{1}|9007199254740990|9007199254740991)$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          }
        }
      },
      "else": {
        "properties": {
          "round": {
            "const": ""
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "artifact_sha256": {
            "const": ""
          }
        }
      },
      "then": {
        "properties": {
          "artifact_size": {
            "const": ""
          }
        }
      },
      "else": {
        "properties": {
          "event_type": {
            "enum": [
              "model_released",
              "deployment_accepted"
            ]
          },
          "artifact_size": {
            "pattern": "^(?:0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$",
            "not": {
              "pattern": "[\\r\\n]"
            }
          }
        }
      }
    }
  ]
}
